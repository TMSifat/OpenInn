# ---- Required ----
# Password for the web dashboard (username can be anything). Required in production.
DASHBOARD_PASSWORD=

# AI model as "<provider>:<model id>". Providers: anthropic, openai, google, groq, ollama
AI_MODEL=anthropic:claude-sonnet-5-5
# Set the key for the provider you use
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GROQ_API_KEY=
# Free local models with Ollama (inside Docker, use http://host.docker.internal:11434)
# AI_MODEL=ollama:llama3.1
# OLLAMA_URL=http://localhost:11434

# ---- Property management system (set one or more) ----
# Hospitable: Personal Access Token from Hospitable > Apps > API access
HOSPITABLE_TOKEN=
# Hostaway: account ID and API key from Hostaway > Settings > Hostaway API
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_KEY=
# Guesty: Open API client credentials from Guesty > Integrations > API
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=

# ---- Alerts when the assistant needs you (set one or both) ----
# Telegram: create a bot with @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email: SMTP connection URL, e.g. smtps://user:password@smtp.gmail.com:465
SMTP_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# ---- Optional ----
# Public address of the dashboard, used in alert links
PUBLIC_URL=http://localhost:3000
# Replies below this confidence (0-1) go to you instead of being sent
CONFIDENCE_THRESHOLD=0.8
# How often to check the PMS for new messages
POLL_INTERVAL_SECONDS=60
